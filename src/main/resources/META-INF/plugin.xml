<idea-plugin>
  <id>net.sjrx.intellij.plugins.avecmoi</id>
  <name>avec-moi</name>
  <vendor email="vcolo@sjrx.net" url="https://sjrx.net">SJrX</vendor>

  <description><![CDATA[
    Collaborative coding: the AI scaffolds and designs, you implement the load-bearing pieces,
    the AI reviews. Keeps you engaged and your expertise sharp instead of watching code appear.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.plugins.terminal</depends>

  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="net.sjrx.intellij.plugins.avecmoi.AvecMoiStartup"/>
    <toolWindow id="Avec Moi"
                anchor="right"
                icon="/META-INF/pluginIcon.svg"
                factoryClass="net.sjrx.intellij.plugins.avecmoi.AvecMoiToolWindowFactory"/>
  </extensions>

  <actions>
    <!-- Grouped under a single Tools submenu (name TBD — see project decision). -->
    <group id="avecmoi.MenuGroup" text="Avec Moi" popup="true">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <action id="avecmoi.StepDone"
              class="net.sjrx.intellij.plugins.avecmoi.StepDoneAction"
              text="Step Done → Agent"
              description="Inject 'Step done' into the running agent terminal session and submit it">
        <keyboard-shortcut keymap="$default" first-keystroke="control alt shift D"/>
      </action>
      <action id="avecmoi.NextHandoff"
              class="net.sjrx.intellij.plugins.avecmoi.NextHandoffAction"
              text="Next Handoff"
              description="Jump to the next handoff the agent registered for you to implement"/>
      <action id="avecmoi.AskForHint"
              class="net.sjrx.intellij.plugins.avecmoi.AskForHintAction"
              text="Ask for a Hint"
              description="Ask the agent for a hint at the cursor or selection (saves the file, sends a reference)"/>
    </group>
  </actions>
</idea-plugin>
