<idea-plugin>
  <id>net.sjrx.intellij.plugins.avecmoi</id>
  <name>Avec Moi</name>
  <vendor email="vcolo@sjrx.net" url="https://sjrx.net">SJrX</vendor>

  <description><![CDATA[
    Collaborative coding: the AI scaffolds and designs, you implement the load-bearing pieces,
    the AI reviews. Keeps you engaged and your expertise sharp instead of watching code appear.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.plugins.terminal</depends>

  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="net.sjrx.intellij.plugins.avecmoi.AvecMoiStartup"/>
    <projectConfigurable parentId="tools"
                         id="net.sjrx.intellij.plugins.avecmoi.settings"
                         displayName="Avec Moi"
                         instance="net.sjrx.intellij.plugins.avecmoi.AvecMoiConfigurable"/>
    <toolWindow id="Avec Moi"
                anchor="right"
                icon="/META-INF/pluginIcon.svg"
                factoryClass="net.sjrx.intellij.plugins.avecmoi.AvecMoiToolWindowFactory"/>
  </extensions>

  <actions>
    <!-- Grouped under a single Tools submenu (name TBD — see project decision). -->
    <group id="avecmoi.MenuGroup" text="Avec Moi" popup="true">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <action id="avecmoi.QuickList"
              class="net.sjrx.intellij.plugins.avecmoi.AvecMoiQuickListAction"
              text="Avec Moi Actions…"
              description="Pop up the Avec Moi quick menu (handoff navigation and the agent-signal actions)">
        <!-- $default alt+shift+A shadows only VcsHistory.ShowAllAffected (VCS-history view); harmless. -->
        <keyboard-shortcut keymap="$default" first-keystroke="alt shift A"/>
      </action>
      <separator/>
      <action id="avecmoi.StepDone"
              class="net.sjrx.intellij.plugins.avecmoi.StepDoneAction"
              text="Step Done"
              description="Tell the agent you finished this step and it can review your implementation">
        <keyboard-shortcut keymap="$default" first-keystroke="control alt shift D"/>
      </action>
      <action id="avecmoi.PreviousHandoff"
              class="net.sjrx.intellij.plugins.avecmoi.PreviousHandoffAction"
              text="Previous Handoff"
              description="Jump to the previous unfinished handoff in the active session (skips completed ones, wraps around)">
        <!-- On KDE, Alt+Shift+F7 is free (Find Usages lives on Shift+Alt+7); elsewhere it's Force Step
             Into, so scope it to KDE and give every other keymap a conflict-free fallback. replace-all
             so KDE uses ONLY Alt+Shift+F7 and doesn't also inherit the $default fallback below. -->
        <keyboard-shortcut keymap="Default for KDE" first-keystroke="alt shift F7" replace-all="true"/>
        <keyboard-shortcut keymap="$default" first-keystroke="control alt shift COMMA"/>
      </action>
      <action id="avecmoi.NextHandoff"
              class="net.sjrx.intellij.plugins.avecmoi.NextHandoffAction"
              text="Next Handoff"
              description="Jump to the next unfinished handoff in the active session (skips completed ones, wraps around)">
        <!-- On KDE, Alt+F7 is free (Find Usages lives on Shift+Alt+7); on $default it IS Find Usages,
             so scope it to KDE and give every other keymap a conflict-free fallback. replace-all so
             KDE uses ONLY Alt+F7 and doesn't also inherit the $default fallback below. -->
        <keyboard-shortcut keymap="Default for KDE" first-keystroke="alt F7" replace-all="true"/>
        <keyboard-shortcut keymap="$default" first-keystroke="control alt shift PERIOD"/>
      </action>
      <action id="avecmoi.AskForHint"
              class="net.sjrx.intellij.plugins.avecmoi.AskForHintAction"
              text="Ask for a Hint"
              description="Ask the agent for a hint at the cursor or selection (saves the file, sends a reference)">
        <keyboard-shortcut keymap="$default" first-keystroke="control alt shift H"/>
      </action>
      <action id="avecmoi.DoThisStep"
              class="net.sjrx.intellij.plugins.avecmoi.DoThisStepAction"
              text="Do This Step"
              description="Hand the current step back to the agent to implement (uses your selection, else the current handoff)">
        <keyboard-shortcut keymap="$default" first-keystroke="control alt shift I"/>
      </action>
    </group>

    <!-- Contents of the Alt+Shift+A quick-menu popup (avecmoi.QuickList). Not added to any menu;
         referenced only by AvecMoiQuickListAction. Order: navigation, then the agent-signal actions. -->
    <group id="avecmoi.QuickListGroup">
      <reference ref="avecmoi.NextHandoff"/>
      <reference ref="avecmoi.PreviousHandoff"/>
      <separator/>
      <reference ref="avecmoi.StepDone"/>
      <reference ref="avecmoi.DoThisStep"/>
      <reference ref="avecmoi.AskForHint"/>
    </group>
  </actions>
</idea-plugin>
